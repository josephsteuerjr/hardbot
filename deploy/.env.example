# Настройки «Выезды». ./install.sh копирует этот файл в .env и дальше читает .env.
# В .env лежат секреты — не класть в систему контроля версий, права 600.

# ============ ОБЯЗАТЕЛЬНО ============

# Telegram-id владельца системы: он всегда администратор, ему приходят заявки
# сотрудников на доступ и сводки. Как узнать: написать боту /whoami
# (или посмотреть в любом боте вроде @userinfobot).
ADMIN_ID=

# Публичный HTTPS-адрес приложения. ИМЕННО HTTPS — по http приложение не
# работает (README, «HTTPS обязателен»). Пример: https://vyezdy.company.ru
MINIAPP_URL=

# Ключ доступа к административному API — им подключается пульт аналитика.
# install.sh генерирует его сам, если поле пустое. Пусто = пульт не подключится.
ADMIN_API_KEY=


# ============ TELEGRAM (необязательно) ============

# Токен бота от @BotFather. Пусто — сервер работает БЕЗ Telegram: приложение,
# фото, пульт работают; пуши руководителям и сводки не отправляются.
# Заполнить и перезапустить (./update.sh) можно в любой момент.
BOT_TOKEN=

# Беседа для сводок и пересылки. Пусто — не используется.
# Как узнать: команда /chatid в нужной беседе.
GROUP_CHAT_ID=


# ============ ГОЛОС ============

# Голосовые комментарии: stt — включено (служба речи из этого же compose),
# off — выключено, сотрудники вводят текст руками. При off контейнер stt не
# запускается и память не занимает.
VOICE_BACKEND=stt

# Модель распознавания. small ≈ 0,7 ГБ памяти (по умолчанию), medium ≈ 1,8 ГБ,
# large-v3 ≈ 3,5 ГБ. Скачивается при первом старте в ./models.
STT_MODEL=small

# Потоков CPU на распознавание: 0 = по числу ядер, но не больше 4.
STT_THREADS=0

# Лимит памяти контейнера речи. 0 = без лимита (по умолчанию). Если ставите —
# с запасом к таблице выше, например 1500m для small.
STT_MEM_LIMIT=0


# ============ СЕТЬ ============

# Порт на localhost, на котором приложение ждёт обратный прокси.
APP_PORT=8080

# Домен — нужен только профилю proxy (встроенный Caddy с автоматическим TLS).
# При своём nginx оставить пустым.
DOMAIN=

# Профили compose через запятую: proxy (встроенный HTTPS), routing (маршруты
# по дорогам, см. deploy/geo). Пусто — только app и stt.
COMPOSE_PROFILES=


# ============ ДОСТУП ============

# Подтверждение привязки сотрудника владельцем.
# 1 — сотрудник запрашивает доступ, владелец подтверждает (по умолчанию).
# 0 — доступ выдаётся сразу. Только для пилота.
BIND_APPROVAL=1

# Домен, которому разрешены кросс-доменные обращения к API.
# Пусто = только собственный домен. Так безопаснее, менять без нужды не надо.
CORS_ALLOW_ORIGIN=


# ============ МАРШРУТЫ (профиль routing) ============

# Адреса маршрутизаторов по странам. Пусто — порядок объезда считается
# упрощённо, система работает полностью. Заполняются после подготовки графов
# (deploy/geo/README.md): OSRM_URL_UZ=http://osrm-uz:5000
OSRM_URL_UZ=
OSRM_URL_TJ=
OSRM_MAX_SNAP_M=5000


# ============ РЕЗЕРВНЫЕ КОПИИ ============

# Сколько последних копий базы хранить в ./backups (backup.sh удаляет старые).
BACKUP_KEEP=14
