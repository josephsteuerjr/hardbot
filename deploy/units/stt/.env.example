# Настройки единицы STT (распознавание речи). ./install.sh копирует этот файл
# в .env и дальше читает .env.
#
# Секретов здесь нет: токен службы создаётся сам и живёт внутри общего тома.
# Включение голоса в приложении — не здесь, а в .env ядра: VOICE_BACKEND=stt.

# ============ МОДЕЛЬ ============

# Модель распознавания. ЗДЕСЬ ДОЛЖНО СТОЯТЬ ИМЯ МОДЕЛИ, ЗАПЕЧЁННОЙ В ОБРАЗ, —
# по умолчанию large-v3-turbo (≈ 0,8 ГБ в образе, ≈ 1,3 ГБ памяти). Её везут
# вместе с исходниками, поэтому служба поднимается без интернета и за секунды.
#
# Впишете другое имя — служба это переживёт (возьмёт запечённую и скажет об
# этом в журнале), но при каждом старте будет писать строку ERROR и строку
# WARNING. Журнал, который пугает без причины, хуже, чем никакого.
#
# Действительно сменить модель — это две команды на машине сборщика, а не
# правка одной строки здесь:
#   python tools/prepare_stt_model.py --repo <репозиторий> --name <имя>
#   cd deploy/units/stt && ./update.sh      # образ пересоберётся с новой моделью
STT_MODEL=large-v3-turbo

# Точность вычислений. int8 — быстро и достаточно; float32 — медленнее и
# заметно прожорливее по памяти. Менять без нужды не надо.
STT_COMPUTE_TYPE=int8

# Потоков процессора на распознавание: 0 = по числу ядер, но не больше 4.
STT_THREADS=0

# Разрешить службе качать модель из интернета (с huggingface.co).
# 0 (по умолчанию) — модель едет внутри образа, в сеть служба не ходит вообще.
# 1 — нужно ровно в одном случае: нужна модель, которой в образе нет, а
#     пересобирать образ не хочется. Тогда первый старт длится столько, сколько
#     качается модель (large-v3-turbo ≈ 1,5 ГБ), и ожидание в unit.conf
#     (UNIT_WAIT_SECONDS) надо увеличить, иначе установка сдастся раньше времени.
STT_ALLOW_DOWNLOAD=0


# ============ ОГРАНИЧЕНИЯ ============

# Сколько распознаваний в минуту принимать (защита от случайного шквала) и
# какой всплеск разрешить сверх этого.
STT_RATE_PER_MINUTE=6
STT_BURST=2

# Лимит памяти контейнера. 2000m — запечённая large-v3-turbo с запасом: замеры
# дают 0,87 ГБ сразу после загрузки и до 1,24 ГБ на пике разбора записи
# (таблица в stt/README.md). Урезать не стоит — на тесном лимите служба не
# падает, а тупит: 2000m — 19 с на запись, 1500m — 26 с, 900m — 35 с.
# 0 = без лимита, но тогда утечка в службе речи положит весь сервер, а не речь.
STT_MEM_LIMIT=2000m
