# Скопируйте в .env и подставьте значения
# Токен Telegram-бота. Пусто — сервер работает только как приложение (без бота,
# без пушей и сводок); включить можно позже через пульт или этот файл.
BOT_TOKEN=123456:ABC-DEF...
# Telegram-id владельца — всегда админ (узнать свой id: напишите боту /whoami)
ADMIN_ID=000000000
# id беседы для пересылки реестра/сводок (узнать: /chatid в беседе). Можно оставить пустым.
GROUP_CHAT_ID=
# Публичный https-URL миниаппа (Cloudflare Tunnel/VPS). Пусто → кнопка «Приложение» не ставится.
MINIAPP_URL=
# Порт веб-сервера миниаппа (по умолчанию 8080).
MINIAPP_PORT=8080
# Голос: служба распознавания речи (контейнер stt/) через Unix-сокет с токеном.
# off — выключено; stt — включено. Автоматического локального фолбэка нет:
# при недоступности службы остаётся ручной ввод. Старые имена PRAXIS_STT_SOCKET /
# PRAXIS_STT_TOKEN_FILE и VOICE_BACKEND=praxis продолжают работать.
VOICE_BACKEND=off
STT_SOCKET=/run/stt/stt.sock
STT_TOKEN_FILE=/run/secrets/stt.token
VOICE_TIMEOUT_SECONDS=60
# --- Безопасность (ИБ) ---
# Аппрув привязки выездника владельцем (1=вкл, по умолчанию; 0=сразу активна, для пилота).
BIND_APPROVAL=1
# GPS при завершении карточки: временно 0 (без точки можно сохранить).
# 1 возвращает обязательную точку в обновленной PWA; сбор гео работает в обоих режимах.
VISIT_GEO_REQUIRED=0
# Сужение CORS: домен, которому разрешён кросс-ориджин к API/тайлам. Пусто = same-origin (без «*»).
CORS_ALLOW_ORIGIN=
# Токен API десктоп-пульта (admin-эндпоинты). Пусто = admin-API недоступен.
ADMIN_API_KEY=
# Токен API ДВИЖКА (engine/): обязателен при работе с реальной БД (HARDBOT_DB). Пусто+синтетика = демо.
ENGINE_API_TOKEN=
# Маршрутизаторы по странам. Hardbot пробует оба и принимает только граф, к которому
# все точки привязались не дальше OSRM_MAX_SNAP_M. Это не даёт UZ-точке «прилипнуть»
# к границе TJ с формально успешным ответом. OSRM_URL — совместимый одиночный фолбэк.
OSRM_URL_UZ=
OSRM_URL_TJ=
OSRM_URL=
# VROOM получает уже проверенную OSRM-матрицу и расставляет точки маршрута дня.
# Пусто = локальный 2-opt; при ошибке VROOM hardbot также автоматически падает на 2-opt.
VROOM_URL=
OSRM_MAX_SNAP_M=5000
# Только для отдельного route-sidecar при бесшовном включении через reverse proxy.
ROUTING_SIDECAR_PORT=8082
