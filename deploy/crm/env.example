# Private .env on the VM. Set CRM_IMAGE to the tested release image digest.
CRM_IMAGE=REPLACE_WITH_TESTED_IMAGE_DIGEST
CRM_PRIMARY_DIR=/opt/hard/deploy/units/core/data
CRM_PRIMARY_FILE=hardbot.db
CRM_POSTGRES_SOCKET=/opt/rimborso-crm-pilot/socket
CRM_APP_DSN_FILE=/opt/rimborso-crm-pilot/secrets/crm_app-dsn
CRM_SESSION_KEY_FILE=/opt/rimborso-crm-pilot/secrets/session-key
CRM_DOCUMENTS_DIR=/opt/rimborso-crm-pilot/documents
CRM_EXCHANGE_DSN_FILE=/opt/rimborso-crm-pilot/exchange/worker-dsn
CRM_EXCHANGE_CONFIG=/opt/rimborso-crm-runtime/exchange.json
CRM_EXCHANGE_STATUS_DIR=/opt/rimborso-crm-runtime/status
