# Скопируйте в .env рядом с docker-compose.yml и заполните.
# Файл содержит секреты — в систему контроля версий не класть.

# ============ ОБЯЗАТЕЛЬНО ============

# Токен бота от @BotFather.
BOT_TOKEN=

# Telegram-id владельца системы. Он всегда администратор.
# Как узнать: напишите боту /whoami
ADMIN_ID=

# Публичный HTTPS-адрес приложения. ИМЕННО HTTPS — по http приложение
# работать не будет (см. README, «HTTPS обязателен»).
# Пример: https://vzyskanie.company.ru
MINIAPP_URL=

# Ключ доступа к административному API (нужен пульту офиса).
# Сгенерировать: openssl rand -base64 48
# Пусто = административный интерфейс недоступен вообще.
ADMIN_API_KEY=


# ============ РЕКОМЕНДУЕТСЯ ============

# Подтверждение привязки сотрудника владельцем.
# 1 — сотрудник запрашивает доступ, владелец подтверждает (по умолчанию).
# 0 — доступ выдаётся сразу. Только для пилота.
BIND_APPROVAL=1

# Домен, которому разрешены кросс-доменные обращения к API.
# Пусто = разрешён только собственный домен. Так безопаснее, менять без нужды не надо.
CORS_ALLOW_ORIGIN=

# Беседа для сводок и пересылки. Пусто — не используется.
# Как узнать: команда /chatid в нужной беседе.
GROUP_CHAT_ID=


# ============ НЕОБЯЗАТЕЛЬНО ============

# Порт внутри контейнера. Менять без нужды не требуется.
MINIAPP_PORT=8080

# Голосовые комментарии. off — выключено, сотрудники вводят текст руками.
# Включение требует отдельно развёрнутого сервиса распознавания речи.
VOICE_BACKEND=off

# Маршрутизация по картам. Пусто — порядок объезда считается упрощённо,
# система работает полностью. Заполняется при развёртывании OSRM (см. compose).
OSRM_URL_UZ=
OSRM_URL_TJ=
OSRM_MAX_SNAP_M=5000
