{
  "name": "hard-desk",
  "productName": "Взыскание СНГ",
  "version": "3.3.9",
  "private": true,
  "description": "Программы взыскания: Хард, Софт, Руководитель и Аналитик",
  "main": "out/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "icons": "electron tools/icons.cjs",
    "dist": "node tools/installers.mjs",
    "check": "tsc -p .",
    "test:queue": "node tools/test-call-queue.cjs",
    "test:manager-account": "node tools/test-manager-account.cjs",
    "test:manager-account-ui": "node build.mjs && node tools/test-manager-account-ui-run.cjs",
    "test:transport": "node tools/test-transport.cjs",
    "test:links": "node tools/test-login-link.cjs",
    "test:runtime-deps": "node tools/test-runtime-dependencies.cjs",
    "backend": "python tools/build-backend.py",
    "installers": "node tools/installers.mjs",
    "test:desktop": "node tools/test-desktop.cjs",
    "test:updates": "node tools/run-electron-test.cjs tools/test-update-flow.cjs",
    "release:prepare": "node tools/prepare-release.mjs",
    "test:enrichment-ui": "node tools/test-enrichment-jobs-ui.cjs",
    "test:registry-defaults": "node tools/test-registry-defaults.cjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "^22.20.4",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "overrides": {
    "global-agent": "4.1.3"
  }
}
