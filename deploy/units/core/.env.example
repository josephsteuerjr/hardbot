# Настройки единицы CORE (приложение). ./install.sh копирует этот файл в .env
# и дальше читает .env. В .env лежат секреты — не класть в систему контроля
# версий, права 600.
#
# Настройки речи (какая модель, сколько потоков) живут не здесь, а в
# deploy/units/stt/.env. Здесь — только «включён ли голос вообще».

# ============ ОБЯЗАТЕЛЬНО ============

# Telegram-id владельца системы: он всегда администратор, ему приходят заявки
# сотрудников на доступ и сводки. Как узнать: написать боту /whoami
# (или посмотреть в любом боте вроде @userinfobot).
ADMIN_ID=

# Публичный HTTPS-адрес приложения. ИМЕННО HTTPS — по http приложение не
# работает (README, «HTTPS обязателен»). Пример: https://hard.company.ru
MINIAPP_URL=

# Ключ доступа к административному API — им подключается пульт аналитика.
# install.sh генерирует его сам, если поле пустое. Пусто = пульт не подключится.
ADMIN_API_KEY=


# ============ TELEGRAM (необязательно) ============

# Токен бота от @BotFather. Пусто — сервер работает БЕЗ Telegram: приложение,
# фото, пульт работают; пуши руководителям и сводки не отправляются.
# Заполнить и перезапустить (./update.sh) можно в любой момент.
BOT_TOKEN=

# Токен СТАРОГО бота — только чтобы проверить подпись его мини-приложения на
# старом адресе (выгрузка очередей телефонов после переезда 23–24.09.2026). Сам
# бот не запускается, основной адрес этот токен не знает. Пусто — на старом
# адресе входят только по ссылке входа.
DRAIN_BOT_TOKEN=

# Беседа для сводок и пересылки. Пусто — не используется.
# Как узнать: команда /chatid в нужной беседе.
GROUP_CHAT_ID=


# ============ ГОЛОС ============

# Голосовые комментарии: stt — включено, off — выключено (сотрудники вводят
# текст руками).
#
# Включать имеет смысл, только если поставлена единица речи
# (deploy/units/stt) — приложение ходит к ней через общий том, а не по сети.
# Если включить без неё, всё остальное работает, а на голосовое сообщение
# сотрудник получит понятный отказ.
VOICE_BACKEND=off

# Сколько ждать ответа от службы речи, секунд (5..70).
VOICE_TIMEOUT_SECONDS=60


# ============ СЕТЬ ============

# Порт на localhost, на котором приложение ждёт обратный прокси.
APP_PORT=8080

# Доступ настольных приложений по корпоративной сети без публичного адреса.
# В Linux раскомментируйте COMPOSE_FILE и задайте конкретный приватный IP ВМ.
# На Windows разделитель файлов — точка с запятой вместо двоеточия.
# COMPOSE_FILE=docker-compose.yml:docker-compose.lan.yml
# Для HTTPS с внутренним УЦ добавьте :docker-compose.lan-tls.yml (см. network-access.md).
APP_LAN_IP=
COMPOSE_FILE=

# Домен — нужен только профилю proxy (встроенный Caddy с автоматическим TLS).
# При своём nginx оставить пустым.
DOMAIN=

# Профили compose этой единицы через запятую. Сейчас поддерживается один:
# proxy — встроенный HTTPS через Caddy. Пусто — только приложение.
COMPOSE_PROFILES=


# ============ ДОСТУП ============

# Подтверждение привязки сотрудника владельцем.
# 1 — сотрудник запрашивает доступ, владелец подтверждает (по умолчанию).
# 0 — доступ выдаётся сразу. Только для пилота.
BIND_APPROVAL=1

# GPS при завершении карточки: временно 0 — можно сохранить без точки, сбор гео
# продолжается. 1 возвращает обязательную точку в обновлённой PWA после
# перезапуска приложения; это политика формы, API принимает старые очереди.
VISIT_GEO_REQUIRED=0

# Домен, которому разрешены кросс-доменные обращения к API.
# Пусто = только собственный домен. Так безопаснее, менять без нужды не надо.
CORS_ALLOW_ORIGIN=


# ============ МАРШРУТЫ (единица gps) ============

# Адреса маршрутизаторов. Заполняются, ТОЛЬКО если поставлена единица gps
# (deploy/units/gps) — имена берутся из её compose-файла, они видны через
# общую сеть hard-net. Пусто — расстояния считаются по прямой, а порядок
# объезда — локальным алгоритмом; система при этом работает полностью.
#
# По одному адресу на страну: точка проверяется по каждому графу, и берётся
# тот, где ВСЕ точки легли близко к дорогам. Лишний адрес маршрут не портит.
OSRM_URL_UZ=
OSRM_URL_TJ=
OSRM_URL_RU=

# Запасной адрес OSRM: используется, если ни один страновой не подошёл.
OSRM_URL=

# Оптимизатор порядка объезда. Пусто — порядок считает локальный алгоритм.
VROOM_URL=

# Максимальное расстояние от точки до дороги, метров. Если точка легла дальше,
# граф считается «не тем» и берётся следующий.
OSRM_MAX_SNAP_M=5000


# ============ РЕЗЕРВНЫЕ КОПИИ ============

# Сколько последних копий базы хранить в ./backups (backup.sh удаляет старые).
BACKUP_KEEP=14
