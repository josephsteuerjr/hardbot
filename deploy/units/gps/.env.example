# Настройки единицы GPS (маршруты по дорогам). ./install.sh копирует этот файл
# в .env и дальше читает .env. Секретов здесь нет.
#
# ВАЖНО: сама по себе эта единица ядру ничего не сообщает. После установки
# впишите её адреса в .env ЯДРА и выполните там ./update.sh:
#   OSRM_URL_UZ=http://osrm-uz:5000
#   OSRM_URL_TJ=http://osrm-tj:5000
#   OSRM_URL_RU=http://osrm-ru:5000
#   VROOM_URL=http://vroom:3000
# Строки тех стран, которых нет, оставьте пустыми.

# ============ КАКИЕ СТРАНЫ ПОДНИМАТЬ ============

# Через запятую, из списка: uz, tj, ru. Поднимается ровно то, что перечислено,
# и только если граф этой страны уже лежит в ./osrm/<страна>/.
# Пусто — поднимется один оптимизатор порядка (vroom), без дорожных графов.
COMPOSE_PROFILES=

# ============ ФАЙЛЫ ГРАФОВ ============

# Имя файла графа внутри ./osrm/<страна>/. Рядом с ним лежит десяток файлов
# с теми же именем и разными расширениями — это нормально, указывается только
# основной .osrm. Сборка графов: deploy/geo/README.md.
OSRM_GRAPH_UZ=uzbekistan-latest.osrm
OSRM_GRAPH_TJ=tajikistan-latest.osrm
OSRM_GRAPH_RU=samara_oblast.osrm

# ============ ПОРТЫ ДЛЯ ПРОВЕРКИ РУКАМИ ============

# Публикуются только на 127.0.0.1 и нужны лишь для диагностики (curl).
# Ядро ходит не по ним, а по именам сервисов в общей сети.
OSRM_PORT_TJ=5001
OSRM_PORT_UZ=5002
OSRM_PORT_RU=5003
VROOM_PORT=3000
